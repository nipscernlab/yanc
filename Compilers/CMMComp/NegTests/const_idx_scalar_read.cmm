#PRNAME p
#NUBITS 16
#NDSTAC 4
#SDEPTH 4
#NUIOIN 1
#NUIOOU 1
#NBMANT 10
#NBEXPO 5
#NUGAIN 128

// Negative fixture: a constant index on a scalar. The constant-index read
// (LOD_V, arr_1d2exp_const) must reject it like the variable-index path.
void main()
{
    int x;
    x = 3;
    out(0, x[0]);
}
