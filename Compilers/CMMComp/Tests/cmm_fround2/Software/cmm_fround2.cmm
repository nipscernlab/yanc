#PRNAME cmm_fround2
#NUBITS 32
#NDSTAC 8
#SDEPTH 8
#NUIOIN 1
#NUIOOU 1
#NBMANT 23
#NBEXPO 8
#NUGAIN 128
#FROUND 2
// Float rounding level 2 (level 1 + round to nearest even with guard/round/
// sticky bits). Same program as cmm_fround0 and
// cmm_fround1 -- only the #FROUND directive differs, so the three goldens show
// what each level buys. Every fout() prints an error in ULPs of 1.0 (2^-22)
// unless noted; u = 1 ULP, h = half ULP, q = quarter ULP.
//
//   block 1 - a mantissa bit is lost before normalization (levels 1 and 2 fix it)
//   block 2 - round to nearest even (level 2 only)
//   block 3 - drift of a 1000-step accumulation of 0.001 (exact result 1.0). A
//             constant addend drops the same bits every step, so the rounding
//             is correlated and even level 2 drifts -- 3x less, other sign
//   block 4 - overflow saturates / underflow flushes / -0.0 == 0.0 (levels 1 and 2)
//   block 5 - I2F of ints beyond +-2^22 and F2I of floats beyond +-2^31 (level 0
//             wraps both; level 1 converts the whole word truncating, level 2
//             rounding; both saturate F2I)
//   block 6 - a constant below the smallest normal float (1.2e-32 at 32/23/8):
//             a denormal at level 0, flushed to zero at levels 1/2
void main()
{
    float one  = 1.0;
    float u    = 0.000000238418579101562500;               // 2^-22 = 1 ULP of 1.0
    float h    = 0.000000119209289550781250;               // 2^-23 = half ULP
    float q    = 0.000000059604644775390625;               // 2^-24 = quarter ULP
    float hp   = 0.000000120140612125396728515625;         // 2^-23 + 2^-30 (just above half)
    float big  = 1000000000000000000000000000000.0;        // 1e30
    float tiny = 0.000000000000000000000000000001;         // 1e-30
    float ulp  = 4194304.0;                                // 2^22: scales an error at 1.0 to ULPs
    float d33  = 0.000000000000000000000000000000001;   // 1e-33
    float b36  = 1000000000000000000000000000000000000.0;   // 1e36
    float x, y, z, acc;
    int   k, flag;

    while (1)
    {
        // block 1: lost bit ------------------------------------- level 0 / 1 / 2
        x = (one + u) - one;  y = x * ulp;          fout(0, y);   //   0  /  1  /  1   (exact 1)
        x = (one + u) * one;  y = (x - one) * ulp;  fout(0, y);   //   0  /  1  /  1   (exact 1)
        x = one / 1.5;        y = x * 3.0 - 2.0;    y = y * ulp; fout(0, y); // 0 / -2 / 0 (exact 0; level 0 loses the residual itself)

        // block 2: rounding ------------------------------------- level 0 / 1 / 2
        x = one + q;          y = (x - one) * ulp;  fout(0, y);   //   0  /  0  /  0   (below half ULP)
        x = one + h;          y = (x - one) * ulp;  fout(0, y);   //   0  /  0  /  0   (tie -> even)
        x = one + hp;         y = (x - one) * ulp;  fout(0, y);   //   0  /  0  /  1   (above half)
        x = (one + u) + h;    y = (x - one) * ulp;  fout(0, y);   //   0  /  1  /  2   (tie, odd -> up)
        x = 1.5 * (one + u);  y = (x - 1.5) * ulp;  fout(0, y);   //   0  /  1  /  2   (tie, odd -> up)

        // block 3: accumulation drift --------------------------- level 0 / 1 / 2
        acc = 0.0;
        for (k = 0; k < 1000; k = k + 1) acc = acc + 0.001;
        y = (acc - one) * ulp;                      fout(0, y);   // -240 / -177 / 78  (exact 0)

        // block 4: range and zero ------------------------------- level 0 / 1 / 2
        y = big * big;   if (y > big)   flag = 1; else flag = 0; out(0, flag); // 0 / 1 / 1  (1 = saturated)
        y = tiny * tiny; if (y == 0.0)  flag = 1; else flag = 0; out(0, flag); // 0 / 1 / 1  (1 = flushed to zero)
        z = x - x;       y = -z;
                         if (y == 0.0)  flag = 1; else flag = 0; out(0, flag); // 0 / 1 / 1  (1 = -0.0 equals 0.0)

        // block 5: I2F / F2I range -------------------------------- level 0 / 1 / 2
        k = 4194303;          x = k;  fout(0, x);   // 4194303 / 4194303 / 4194303  (fits the mantissa)
        k = 5000000;          x = k;  fout(0, x);   // -3388608 / 5000000 / 5000000  (bit 22 taken as the sign)
        k = 16777217;         x = k;  fout(0, x);   // 1 / 16777216 / 16777216  (2^24+1: two bits dropped, 0.25 -> down)
        k = 16777219;         x = k;  fout(0, x);   // 3 / 16777216 / 16777220  (2^24+3: two bits dropped, 0.75 -> up at level 2)
        k = 2147483647;       x = k;  fout(0, x);   // -1 / 2147483392 / 2147483647  (level 2 rounds to 2^31, F2I saturates)
        k = -2147483647 - 1;  x = k;  fout(0, x);   // 0 / -2147483648 / -2147483648  (low 23 bits are zero)
        x = 3000000000.0;             out(0, x);    // -1294967296 / 2147483647 / 2147483647  (F2I saturates)
        x = -3000000000.0;            out(0, x);    // 1294967296 / -2147483648 / -2147483648

        // block 6: constant below the smallest normal --------- level 0 / 1 / 2
        x = d33 * b36;                fout(0, x);   // 999 / 0 / 0  (exact 1000, fout truncates 999.99; before the encoder fix
                                                    //   level 0 saw 1e-33 as 1.6e-32 and printed ~16000)
    }
}
