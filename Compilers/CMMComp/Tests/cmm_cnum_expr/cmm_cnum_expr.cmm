#NUBITS 32
#NBMANT 23
#NBEXPO 8
#NUIOIN 1
#NUIOOU 1

// Complex literals after the cmmcomp audit (2026-10-30): the lexer reads an
// imaginary literal (2i, 2.5i) and the parser writes a + bi as an expression,
// so precedence is C's. Two literals are one comp literal (3 - 2i); a real
// expression and an imaginary literal are complex(x, b), no add of a zero.
// Before, the lexer glued 3+2i into one token: y*3+2i was y*(3+2i) and
// n-1+2i, w - 3 + 4i were syntax errors. fout truncates: every part is an
// integer here.
//
// Expected, real then imaginary: 6 2 (y*3+2i, y = 2), 3 2 (n-1+2i, n = 4),
// -2 5 (w - 3 + 4i, w = 1+1i), 3 -2 (3 - 2 i), -3 2 (2i - 3), 0 -2 (-2i),
// -1 -5 (-1-5i), 2 1 (x + 1i, x = 2), -2 1 (1i - x), -4 0 (2i*2i), then the
// brace list {1+2i, -3-4i, 2i, -5+6i}: 1 2 -3 -4 0 2 -5 6.

comp v[4] = {1+2i, -3-4i, 2i, -5+6i};

void put(comp z)
{
    fout(0, real(z));
    fout(0, imag(z));
}

void main()
{
    comp z; comp w; float y; float x; int n; int k;
    y = 2.0; n = 4; w = 1+1i; x = 2.0;
    z = y*3+2i;     put(z);
    z = n-1+2i;     put(z);
    z = w - 3 + 4i; put(z);
    z = 3 - 2 i;    put(z);
    z = 2i - 3;     put(z);
    z = -2i;        put(z);
    z = -1-5i;      put(z);
    z = x + 1i;     put(z);
    z = 1i - x;     put(z);
    z = 2i*2i;      put(z);
    for (k = 0; k < 4; k++) put(v[k]);
}
