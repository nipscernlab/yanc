#NUBITS 23
#NUIOIN 1
#NUIOOU 1
#NBMANT 16
#NBEXPO 6
#NUGAIN 128

// Synthetic fixture: exercises the four assignment-form Dirac rules that
// no example program uses. The declaration-form variants appear in
// proc_rls. Not a real DSP example. Each is computed by the Dirac loops
//
//   a # |M|b>      matrix by vector       (dirac.c,
//   a # c|b>       scalar by vector        docs/design/
//   A # |a><b|     outer product           dirac-expressions.md)
//   a # c|in(p)>   scalar by input

float A[4][4];
float B[4][4];
float a[4];
float b[4];

void main()
{
    A # 1.0|I|;
    B # 1.0|I|;
    a # |0⟩;
    b # |0⟩;

    while (1)
    {
        a # |B|a⟩;           // a = B * a
        a # 2.0|b⟩;          // a = 2.0 * b
        A # |a⟩⟨b|;          // A = a * b^T
        a # 0.001|in(0)⟩;    // a = 0.001 * input(0)
        out(0, 1);
    }
}
