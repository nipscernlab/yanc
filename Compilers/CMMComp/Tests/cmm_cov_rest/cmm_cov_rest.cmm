    fout(0, 4.0*sf[2]);
    fout(0, 4.0*sf[3]);
    sf # (ret_f_f0()+gfz) -> |sf⟩;
    fout(0, 4.0*sf[0]);
    fout(0, 4.0*sf[1]);
    fout(0, 4.0*sf[2]);
    fout(0, 4.0*sf[3]);
    sf # (1.5+1.0) -> |sf⟩;
    fout(0, 4.0*sf[0]);
    fout(0, 4.0*sf[1]);
    fout(0, 4.0*sf[2]);
    fout(0, 4.0*sf[3]);
    sf # (sf[2]+gfz) -> |sf⟩;
    fout(0, 4.0*sf[0]);
    fout(0, 4.0*sf[1]);
    fout(0, 4.0*sf[2]);
    fout(0, 4.0*sf[3]);
    out(0, gf);
    out(0, (gf+gfz));
    out(0, 2.5);
    fout(0, gi);
    fout(0, (gi+gz));
    fout(0, 7);
}
