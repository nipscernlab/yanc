#NUBITS 8
#NUIOIN 1
#NUIOOU 1
// An int-only processor of 8 bits: no #NBMANT or #NBEXPO, so they keep 23/8,
// and cmmcomp took the int as 32 bits where it reasoned about values (issue
// #14). A decimal literal past 127 is now an error (NegTests/int_word8.cmm);
// past the word a value comes only from arithmetic, which wraps. A constant
// expression is folded and taken to the word, as the hardware computes it:
// 100 + 100 is -56, 64 + 64 the most negative int, which a program writes
// -128 (128 is taken only after a minus). 0xC8 is the word's bits,
// -56, so the loops below run as the same loops with a computed bound: 0
// times each. An array size is no value of the word: 200 positions compile,
// with a warning that an int index reaches only 127.
// Expected outputs: -56 -56 -112 -112 -128 -128 -128 0 0 0 22 5
void main()
{
    int a = 100;
    int k;
    int n = 0;
    int s = 3;
    int big[200];

    out(0, 100 + 100);                            // -56, folded
    out(0, a + a);                                // -56, computed
    out(0, 20 * 20);                              // -112, folded
    out(0, (a - 80) * (a - 80));                  // -112, computed
    out(0, 64 + 64);                              // -128, folded
    out(0, (a - 36) + (a - 36));                  // -128, computed
    out(0, -128);                                 // -128, written

    for (k = 0; k < 0xC8; k = k + 1) n = n + 1;   // 0 < -56: never
    out(0, n);
    n = 0;
    for (k = 0; k < a + a; k = k + 1) n = n + 1;  // the same, computed
    out(0, n);
    n = 0;
    for (k = 0; k < 100 + 100; k = k + 1) n = n + 1;  // the same, folded
    out(0, n);

    switch (s)
    {
        case 120: out(0, 11); break;
        case 3:   out(0, 22); break;
        default:  out(0, 33);
    }

    big[100] = 5;
    out(0, big[100]);
}
