#NUBITS 32
#NBMANT 23
#NBEXPO 8
#NUIOIN 1
#NUIOOU 1
// Arrays initialized between braces, as in C (2026-10-20): the values go
// into the data memory's .mif through #arrayd, no instruction stores them,
// and the positions not given are zero. Expected (hand-computed):
//   a[5] = {3, -2, 7}                         -> 3 -2 7 0 0
//   f[3] = {1.5, -0.25, 4}, each times 8      -> 12 -2 32
//   m[2][3] = {{1, 2}, {4, 5, 6}}: [0][1] [0][2] [1][0] [1][2] -> 2 0 4 6
//   q[2][2] = {1, 2, 3}, no inner braces: [1][0] [1][1] -> 3 0
//   c[2] = {1.5-2i, 3}: real and imag of each, times 2 -> 3 -4 6 0
//   a local l[3] = {4, 5}: l[1] + l[2], twice (the second call sees what
//   the first wrote: l[2] = 9 stays)          -> 5 14
#define N 5

int   a[N]   = {3, -2, 7};
float f[3]   = {1.5, -0.25, 4};
int   m[2][3] = {{1, 2}, {4, 5, 6}};
int   q[2][2] = {1, 2, 3};
comp  c[2]   = {1.5-2i, 3};

int loc()
{
    int l[3] = {4, 5};
    int s = l[1] + l[2];
    l[2] = 9;
    return s;
}

void main()
{
    int k;
    for (k = 0; k < N; k = k + 1) out(0, a[k]);
    for (k = 0; k < 3; k = k + 1) fout(0, f[k] * 8.0);
    out(0, m[0][1]); out(0, m[0][2]); out(0, m[1][0]); out(0, m[1][2]);
    out(0, q[1][0]); out(0, q[1][1]);
    for (k = 0; k < 2; k = k + 1)
    {
        fout(0, real(c[k]) * 2.0);
        fout(0, imag(c[k]) * 2.0);
    }
    out(0, loc());
    out(0, loc());
}
