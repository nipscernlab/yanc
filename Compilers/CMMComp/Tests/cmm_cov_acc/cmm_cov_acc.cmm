#NUBITS 32
#NBMANT 23
#NBEXPO 8
#NUIOIN 1
#NUIOOU 1

// Generated by Scripts/cov_tests.py (#108): the division, the remainder and
// the comparisons of an int with a float, both operands in memory, run with
// a product pending in the accumulator, so each loads with P_LOD or
// P_I2F_M. The expected output is computed by the script, apart from YANC.

void main()
{
    int a, b, p, q;
    float f;
    a = 7; b = 3; p = 17; q = 5; f = 2.5;
    out(0, (a*b) + (p/q));
    out(0, (a*b) + (p%q));
    out(0, (a*b) + (p < f));
    out(0, (a*b) + (f < p));
    out(0, (a*b) + (p > f));
    out(0, (a*b) + (f > p));
    out(0, (a*b) + (p <= f));
    out(0, (a*b) + (f <= p));
    out(0, (a*b) + (p >= f));
    out(0, (a*b) + (f >= p));
    out(0, (a*b) + (p == f));
    out(0, (a*b) + (f == p));
    out(0, (a*b) + (p != f));
    out(0, (a*b) + (f != p));
    a = 7; b = 3; p = -17; q = 5; f = 9.75;
    out(0, (a*b) + (p/q));
    out(0, (a*b) + (p%q));
    out(0, (a*b) + (p < f));
    out(0, (a*b) + (f < p));
    out(0, (a*b) + (p > f));
    out(0, (a*b) + (f > p));
    out(0, (a*b) + (p <= f));
    out(0, (a*b) + (f <= p));
    out(0, (a*b) + (p >= f));
    out(0, (a*b) + (f >= p));
    out(0, (a*b) + (p == f));
    out(0, (a*b) + (f == p));
    out(0, (a*b) + (p != f));
    out(0, (a*b) + (f != p));
    a = 4; b = 2; p = 3; q = 2; f = 3.0;
    out(0, (a*b) + (p/q));
    out(0, (a*b) + (p%q));
    out(0, (a*b) + (p < f));
    out(0, (a*b) + (f < p));
    out(0, (a*b) + (p > f));
    out(0, (a*b) + (f > p));
    out(0, (a*b) + (p <= f));
    out(0, (a*b) + (f <= p));
    out(0, (a*b) + (p >= f));
    out(0, (a*b) + (f >= p));
    out(0, (a*b) + (p == f));
    out(0, (a*b) + (f == p));
    out(0, (a*b) + (p != f));
    out(0, (a*b) + (f != p));
}
