#NUBITS 32
#NBMANT 23
#NBEXPO 8
#NUIOIN 1
#NUIOOU 1

// Generated by Scripts/cov_tests.py (#108): the division, the remainder and
// the comparisons of an int with a float, both operands in memory, run with
// a product pending in the accumulator, so each loads with P_LOD or
// P_I2F_M; then the arms of a choice inside an emitter no other test takes
// (a comp by an imaginary constant, == with a comp, a shift by a float,
// each free and pending; a switch from case 0; a Dirac store that
// converts). The expected output is computed by the script, apart from YANC.

int iv[3];
float fv[3];

void main()
{
    int a, b, p, q, x, k;
    float f, g;
    comp z, w, r;
    a = 7; b = 3; p = 17; q = 5; f = 2.5;
    out(0, (a*b) + (p/q));
    out(0, (a*b) + (p%q));
    out(0, (a*b) + (p < f));
    out(0, (a*b) + (f < p));
    out(0, (a*b) + (p > f));
    out(0, (a*b) + (f > p));
    out(0, (a*b) + (p <= f));
    out(0, (a*b) + (f <= p));
    out(0, (a*b) + (p >= f));
    out(0, (a*b) + (f >= p));
    out(0, (a*b) + (p == f));
    out(0, (a*b) + (f == p));
    out(0, (a*b) + (p != f));
    out(0, (a*b) + (f != p));
    a = 7; b = 3; p = -17; q = 5; f = 9.75;
    out(0, (a*b) + (p/q));
    out(0, (a*b) + (p%q));
    out(0, (a*b) + (p < f));
    out(0, (a*b) + (f < p));
    out(0, (a*b) + (p > f));
    out(0, (a*b) + (f > p));
    out(0, (a*b) + (p <= f));
    out(0, (a*b) + (f <= p));
    out(0, (a*b) + (p >= f));
    out(0, (a*b) + (f >= p));
    out(0, (a*b) + (p == f));
    out(0, (a*b) + (f == p));
    out(0, (a*b) + (p != f));
    out(0, (a*b) + (f != p));
    a = 4; b = 2; p = 3; q = 2; f = 3.0;
    out(0, (a*b) + (p/q));
    out(0, (a*b) + (p%q));
    out(0, (a*b) + (p < f));
    out(0, (a*b) + (f < p));
    out(0, (a*b) + (p > f));
    out(0, (a*b) + (f > p));
    out(0, (a*b) + (p <= f));
    out(0, (a*b) + (f <= p));
    out(0, (a*b) + (p >= f));
    out(0, (a*b) + (f >= p));
    out(0, (a*b) + (p == f));
    out(0, (a*b) + (f == p));
    out(0, (a*b) + (p != f));
    out(0, (a*b) + (f != p));
    z = 1.5+2.0i; w = 1.5+2.0i; p = 40; g = 2.0; a = 7; b = 3;
    r = z * 2.0i; fout(0, 4.0*real(r)); fout(0, 4.0*imag(r));
    r = (z + w) + z * 2.0i; fout(0, 4.0*real(r)); fout(0, 4.0*imag(r));
    x = (z == w); out(0, x);
    x = ((a*b) + (a*b)) + (z == w); out(0, x);
    x = (a == z); out(0, x);
    x = (a*b) + (a == z); out(0, x);
    x = p << g; out(0, x);
    x = (a*b) + (p << g); out(0, x);
    k = 2; switch (k) { case 0: out(0, 1); break; case 2: out(0, 2); break; case 3: out(0, 3); }
    f = 2.5; q = 2;
    iv # f|0⟩; out(0, iv[1]);
    fv # q|0⟩; fout(0, fv[1]);
}
