#NUBITS 8
#NUIOIN 1
#NUIOOU 1
// The keyboard block (SAPHO/myKeyPS2.v) on a C+- SAPHO with an 8-bit word:
// a character fits in 8 bits, so the keyboard needs no wider processor.
// Each key read with cade_sync(0) is echoed to port 0. Built and run by the
// regress project pass KEYPS2 (TopLevel/keyps2_tb.v), US layout.
void main()
{
    int c;
    while (1)
    {
        c = cade_sync(0);
        out(0, c);
    }
}
