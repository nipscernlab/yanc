#PRNAME link_pong
#NUBITS 32
#NUIOIN 1
#NUIOOU 1
#NBMANT 23
#NBEXPO 8
#NUGAIN 128

// toma/cade fixture, project pass LINK: takes a value, hands back value + 1,
// with no wait of its own. cade() inside an expression whose left side is
// already in acc: the compiler pushes it (PSH) before CAD.
void main()
{
    int um = 1;
    while (1)
    {
        toma(um * um + cade());
    }
}
