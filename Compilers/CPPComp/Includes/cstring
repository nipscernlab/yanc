#pragma once
// CPPComp <cstring>. The target is word-addressed: sizeof is in words
// (sizeof(int) == sizeof(char) == 1), so the size memcpy / memset take --
// almost always a sizeof -- counts words, and memset writes v to each whole
// word (C fills bytes: the same only for v == 0). A string is an array of
// chars, one char a word, ended by a 0, as in C; the str functions work on it
// exactly as C's do. Code a program does not call costs nothing.
namespace std {
    inline void* memcpy(void* dst, const void* src, int n) {
        int* d = (int*)dst;
        const int* s = (const int*)src;
        for (int i = 0; i < n; i = i + 1) d[i] = s[i];
        return dst;
    }
    inline void* memset(void* dst, int v, int n) {
        int* d = (int*)dst;
        for (int i = 0; i < n; i = i + 1) d[i] = v;
        return dst;
    }
    // memcpy that may overlap: copies backwards when dst is above src
    inline void* memmove(void* dst, const void* src, int n) {
        int* d = (int*)dst;
        const int* s = (const int*)src;
        if (d > s) { for (int i = n - 1; i >= 0; i = i - 1) d[i] = s[i]; }
        else       { for (int i = 0; i < n; i = i + 1) d[i] = s[i]; }
        return dst;
    }
    inline int memcmp(const void* a, const void* b, int n) {
        const int* x = (const int*)a;
        const int* y = (const int*)b;
        for (int i = 0; i < n; i = i + 1)
            if (x[i] != y[i]) return x[i] < y[i] ? -1 : 1;
        return 0;
    }
    inline void* memchr(const void* p, int c, int n) {
        const int* x = (const int*)p;
        for (int i = 0; i < n; i = i + 1) if (x[i] == c) return (void*)(x + i);
        return 0;
    }

    inline int strlen(const char* s) {
        int n = 0;
        while (s[n]) n = n + 1;
        return n;
    }
    inline int strcmp(const char* a, const char* b) {
        while (*a && *a == *b) { a++; b++; }
        return (*a == *b) ? 0 : (*a < *b ? -1 : 1);
    }
    inline int strncmp(const char* a, const char* b, int n) {
        for (int i = 0; i < n; i = i + 1) {
            if (a[i] != b[i]) return a[i] < b[i] ? -1 : 1;
            if (a[i] == 0) return 0;
        }
        return 0;
    }
    inline char* strcpy(char* dst, const char* src) {
        int i = 0;
        while (src[i]) { dst[i] = src[i]; i = i + 1; }
        dst[i] = 0;
        return dst;
    }
    // as C's: copies at most n chars and pads with 0 up to n; no 0 is added
    // when src has n chars or more
    inline char* strncpy(char* dst, const char* src, int n) {
        int i = 0;
        while (i < n && src[i]) { dst[i] = src[i]; i = i + 1; }
        while (i < n) { dst[i] = 0; i = i + 1; }
        return dst;
    }
    inline char* strcat(char* dst, const char* src) {
        strcpy(dst + strlen(dst), src);
        return dst;
    }
    // appends at most n chars, and always the 0
    inline char* strncat(char* dst, const char* src, int n) {
        char* d = dst + strlen(dst);
        int i = 0;
        while (i < n && src[i]) { d[i] = src[i]; i = i + 1; }
        d[i] = 0;
        return dst;
    }
    inline char* strchr(const char* s, int c) {
        while (*s != c) { if (*s == 0) return 0; s++; }
        return (char*)s;
    }
    inline char* strrchr(const char* s, int c) {
        const char* r = 0;
        while (1) { if (*s == c) r = s; if (*s == 0) break; s++; }
        return (char*)r;
    }
    inline char* strstr(const char* h, const char* n) {
        if (*n == 0) return (char*)h;
        for (; *h; h++) {
            int i = 0;
            while (n[i] && h[i] == n[i]) i = i + 1;
            if (n[i] == 0) return (char*)h;
        }
        return 0;
    }
}
