#pragma once
// CPPComp <cstring>: a small subset. The target is word-addressed: sizeof is
// in words (sizeof(int) == 1), so the size memcpy / memset take -- almost
// always a sizeof -- counts words, and memset writes v to each whole word
// (C fills bytes: the same only for v == 0).
namespace std {
    inline void* memcpy(void* dst, const void* src, int n) {
        int* d = (int*)dst;
        const int* s = (const int*)src;
        for (int i = 0; i < n; i = i + 1) d[i] = s[i];
        return dst;
    }
    inline void* memset(void* dst, int v, int n) {
        int* d = (int*)dst;
        for (int i = 0; i < n; i = i + 1) d[i] = v;
        return dst;
    }
}
