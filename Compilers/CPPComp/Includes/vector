#pragma once
// CPPComp <vector>: a std::vector<T> on the heap (2048 words, shared with
// every new). The constructor makes an empty vector, and so does the zeroed
// state (_data=0, _len=0, _cap=0) a global starts in. Each vector<T> is its
// own instance with T's element type, so operator[] returns a true T&. A new
// that finds no memory ends the program (#129).
namespace std {
    template<class T>
    class vector {
        T*  _data;
        int _len;
        int _cap;
    public:
        vector() { _data = 0; _len = 0; _cap = 0; }
        int size() { return _len; }
        T*  data() { return _data; }
        T&  operator[](int i) { return _data[i]; }
        void reserve(int n) {
            if (n <= _cap) return;
            T* nd = new T[n];
            for (int i = 0; i < _len; i = i + 1) nd[i] = _data[i];
            if (_data) delete[] _data;
            _data = nd;
            _cap = n;
        }
        void resize(int n) {
            reserve(n);
            for (int i = _len; i < n; i = i + 1) { T z{}; _data[i] = z; }   // value-initialized, as
                                                                          // in C++ (#128: a struct took mem[0])
            _len = n;
        }
        void push_back(T x) {
            if (_len == _cap) { int nc = _cap ? _cap * 2 : 4; reserve(nc); }
            _data[_len] = x;
            _len = _len + 1;
        }
    };
}
