#NUBITS 32
#NBMANT 23
#NBEXPO 8
#NUIOIN 1
#NUIOOU 1

// operand order: are x*y and y*x, x+y and y+x, a-t and -t+a the same bits?
// output: 1 when all three pairs agree, else 0, for 500 random pairs
void main()
{
    int n = 0;
    int bad = 0;
    float x; float y; float p; float q; int ip; int iq;
    while (n < 500)
    {
        x = fin(0)*0.0013;
        y = fin(0)*0.00071;
        p = x*y; q = y*x;
        copy(p, ip); copy(q, iq);
        if (ip != iq) bad++;
        p = x+y; q = y+x;
        copy(p, ip); copy(q, iq);
        if (ip != iq) bad++;
        p = x-y; q = -y+x;
        copy(p, ip); copy(q, iq);
        if (ip != iq) bad++;
        n++;
    }
    out(0, bad);
}
