// Blind sparse deconvolution port to CMM (SAPHO).
// y[n] = sum_k h[k] x[n-k] + v[n]
// Lambda selected by BIC over lambda = sigma * gamma.
//
// Fixed compile-time sizes:
//   N  = 1006  (waveform length)
//   M  = 7     (pulse length)
//   C  = 3     (peak index, h[C] fixed at 1)
//   LX = 1000  (sparse-sequence length, N - M + 1)
//
// CMM restrictions handled:
//   - arrays cannot be function parameters -> all arrays are global
//   - no for loop                          -> only while
//   - no +=, -=, *=                        -> explicit assignment
//   - no log()                             -> log(1006) hardcoded
//   - no exponent literals (1e-6)          -> written out long-form

#PRNAME procBlind
#NUBITS 32
#NBMANT 23
#NBEXPO 8
#NDSTAC 10
#SDEPTH 10
#NUIOIN 1
#NUIOOU 4

// ----------------------------------------------------------------------------
// Globals --------------------------------------------------------------------
// ----------------------------------------------------------------------------

// Input waveform, loaded at compile time.
float y[1006] "y.txt";

// Outputs.
float x_hat[1000];
float h_hat[7];
float selected_lambda;

// Scratch buffers (no malloc; fixed sizes).
float s_z     [1000];
float s_x_prev[1000];
float s_grad_x[1000];
float s_conv  [1006];   // full convolution / residual
float s_h_cand[7];
float s_grad_h[7];

// BIC sweep grid: lambda candidates are sigma * lambda_grid[ii].
float lambda_grid[12] "lambda_mult.txt";

// ----------------------------------------------------------------------------
// Projection: h[k] >= 0, h[c] = 1 ---------------------------------------------
// ----------------------------------------------------------------------------

void project_h_hat(int dummy)
{
    int ii = 0;
    while (ii < 7)
    {
        if (h_hat[ii] < 0.0) h_hat[ii] = 0.0;
        ii++;
    }
    h_hat[3] = 1.0;
}

void project_h_cand(int dummy)
{
    int ii = 0;
    while (ii < 7)
    {
        if (s_h_cand[ii] < 0.0) s_h_cand[ii] = 0.0;
        ii++;
    }
    s_h_cand[3] = 1.0;
}

// ----------------------------------------------------------------------------
// Lipschitz constant for the gradient of 0.5 ||H x - y||^2 with respect to x.
// For non-negative h, ||H||_op = ||h||_1, so L = (sum h)^2. No FFT needed.
// ----------------------------------------------------------------------------

float lipschitz_x(int dummy)
{
    float s = 0.0;
    int   k = 0;
    while (k < 7) { s = s + h_hat[k]; k++; }
    float L = s * s;
    if (L < 0.000000000001) L = 0.000000000001;
    return L;
}

// ----------------------------------------------------------------------------
// Convolutions: s_conv <- conv_full(source_Lx, kernel_M), length N=1006 -------
// ----------------------------------------------------------------------------

void conv_zh(int dummy)
{
    int n = 0;
    while (n < 1006) { s_conv[n] = 0.0; n++; }
    int ii = 0;
    while (ii < 1000)
    {
        float zi = s_z[ii];
        int   j  = 0;
        while (j < 7)
        {
            s_conv[ii+j] = s_conv[ii+j] + zi * h_hat[j];
            j++;
        }
        ii++;
    }
}

void conv_xh(int dummy)
{
    int n = 0;
    while (n < 1006) { s_conv[n] = 0.0; n++; }
    int ii = 0;
    while (ii < 1000)
    {
        float xi = x_hat[ii];
        int   j  = 0;
        while (j < 7)
        {
            s_conv[ii+j] = s_conv[ii+j] + xi * h_hat[j];
            j++;
        }
        ii++;
    }
}

void conv_x_hcand(int dummy)
{
    int n = 0;
    while (n < 1006) { s_conv[n] = 0.0; n++; }
    int ii = 0;
    while (ii < 1000)
    {
        float xi = x_hat[ii];
        int   j  = 0;
        while (j < 7)
        {
            s_conv[ii+j] = s_conv[ii+j] + xi * s_h_cand[j];
            j++;
        }
        ii++;
    }
}

// ----------------------------------------------------------------------------
// Subtract y from s_conv to obtain the residual --------------------------------
// ----------------------------------------------------------------------------

void residual_sub_y(int dummy)
{
    int n = 0;
    while (n < 1006) { s_conv[n] = s_conv[n] - y[n]; n++; }
}

// Returns sum(s_conv^2). Assumes residual already in s_conv.
float sum_residual_sq(int dummy)
{
    float s = 0.0;
    int   n = 0;
    while (n < 1006) { s = s + s_conv[n]*s_conv[n]; n++; }
    return s;
}

// ----------------------------------------------------------------------------
// Cross-correlation in valid mode --------------------------------------------
// ----------------------------------------------------------------------------

// s_grad_x[0..LX) = correlate_valid(s_conv, h_hat).
void correlate_residual_h(int dummy)
{
    int n = 0;
    while (n < 1000)
    {
        float s = 0.0;
        int   k = 0;
        while (k < 7) { s = s + s_conv[n+k] * h_hat[k]; k++; }
        s_grad_x[n] = s;
        n++;
    }
}

// s_grad_h[0..M) = correlate_valid(s_conv, x_hat).
void correlate_residual_x(int dummy)
{
    int n = 0;
    while (n < 7)
    {
        float s = 0.0;
        int   k = 0;
        while (k < 1000) { s = s + s_conv[n+k] * x_hat[k]; k++; }
        s_grad_h[n] = s;
        n++;
    }
}

// ----------------------------------------------------------------------------
// FISTA for x with fixed h ----------------------------------------------------
// ----------------------------------------------------------------------------

void fista_x(float lam)
{
    int ii = 0;
    while (ii < 1000) { s_z[ii] = x_hat[ii]; s_x_prev[ii] = x_hat[ii]; ii++; }

    float t        = 1.0;
    float L        = lipschitz_x(0);
    float step     = 1.0 / L;
    float step_lam = step * lam;

    int   have_prev = 0;
    float prev_obj  = 0.0;

    int it = 0;
    while (it < 600)
    {
        // Gradient at z: grad = corr_valid(conv(z, h) - y, h).
        conv_zh(0);
        residual_sub_y(0);
        correlate_residual_h(0);

        // Proximal step: x = max(0, z - step*grad - step*lam).
        ii = 0;
        while (ii < 1000)
        {
            float v = s_z[ii] - step * s_grad_x[ii] - step_lam;
            if (v < 0.0) v = 0.0;
            x_hat[ii] = v;
            ii++;
        }

        // Nesterov momentum.
        float tn  = 0.5 * (1.0 + sqrt(1.0 + 4.0 * t * t));
        float mom = (t - 1.0) / tn;
        ii = 0;
        while (ii < 1000)
        {
            float xi = x_hat[ii];
            s_z[ii]      = xi + mom * (xi - s_x_prev[ii]);
            s_x_prev[ii] = xi;
            ii++;
        }

        // Objective at x for tolerance check.
        conv_xh(0);
        residual_sub_y(0);
        float rss2 = sum_residual_sq(0);
        float data = 0.5 * rss2;

        float sx = 0.0;
        ii = 0;
        while (ii < 1000) { sx = sx + x_hat[ii]; ii++; }
        float obj = data + lam * sx;

        if (have_prev == 1)
        {
            float denom = abs(prev_obj);
            if (denom < 1.0) denom = 1.0;
            float diff = abs(prev_obj - obj);
            if (diff / denom < 0.00001) return;
        }
        prev_obj  = obj;
        have_prev = 1;
        t         = tn;

        it++;
    }
}

// ----------------------------------------------------------------------------
// Projected-gradient update of h with backtracking ----------------------------
// ----------------------------------------------------------------------------

void update_h(int dummy)
{
    project_h_hat(0);
    float step = 0.00001;

    int it = 0;
    while (it < 80)
    {
        // Residual and gradient of the data term wrt h.
        conv_xh(0);
        residual_sub_y(0);
        float rss2 = sum_residual_sq(0);
        float dt   = 0.5 * rss2;

        correlate_residual_x(0);
        s_grad_h[3] = 0.0;

        float trial    = step;
        int   accepted = 0;
        int   bt       = 0;
        while (bt < 30)
        {
            int ii = 0;
            while (ii < 7)
            {
                s_h_cand[ii] = h_hat[ii] - trial * s_grad_h[ii];
                ii++;
            }
            project_h_cand(0);

            conv_x_hcand(0);
            residual_sub_y(0);
            float crss2 = sum_residual_sq(0);
            float cdt   = 0.5 * crss2;

            if (cdt <= dt)
            {
                ii = 0;
                while (ii < 7) { h_hat[ii] = s_h_cand[ii]; ii++; }
                step = trial * 1.05;
                if (step > 0.00001) step = 0.00001;
                accepted = 1;
                break;
            }
            trial = trial * 0.5;
            bt++;
        }
        if (accepted == 0) break;
        it++;
    }
    project_h_hat(0);
}

// ----------------------------------------------------------------------------
// Alternating minimization for one fixed lambda. Returns final data term. -----
// ----------------------------------------------------------------------------

float fit_one(float lam)
{
    int ii = 0;
    while (ii < 1000) { x_hat[ii] = 0.0; ii++; }
    ii = 0;
    while (ii < 7) { h_hat[ii] = 0.0; ii++; }
    h_hat[3] = 1.0;

    int   have_prev = 0;
    float prev_obj  = 0.0;
    float dt        = 0.0;

    int it = 0;
    while (it < 120)
    {
        fista_x(lam);
        update_h(0);

        conv_xh(0);
        residual_sub_y(0);
        float rss2 = sum_residual_sq(0);
        dt = 0.5 * rss2;

        float sx = 0.0;
        ii = 0;
        while (ii < 1000) { sx = sx + x_hat[ii]; ii++; }
        float obj = dt + lam * sx;

        if (have_prev == 1)
        {
            float denom = abs(prev_obj);
            if (denom < 1.0) denom = 1.0;
            float diff = abs(prev_obj - obj);
            if (diff / denom < 0.000001) return dt;
        }
        prev_obj  = obj;
        have_prev = 1;

        it++;
    }
    return dt;
}

// ----------------------------------------------------------------------------
// Top-level: BIC sweep then final fit ----------------------------------------
// ----------------------------------------------------------------------------

void main()
{
    float sigma     = 1.0;
    float noise_var = sigma * sigma;
    float log_N     = 6.913737;  // log(1006)

    int   have_best = 0;
    float best_bic  = 0.0;
    float best_lam  = sigma * lambda_grid[0];

    int li = 0;
    while (li < 12)
    {
        float lam = sigma * lambda_grid[li];
        float dt  = fit_one(lam);
        float rss = 2.0 * dt;

        int active = 0;
        int k = 0;
        while (k < 1000)
        {
            if (x_hat[k] > 0.001) active++;
            k++;
        }

        float num_params = active + 6.0;
        float bic        = rss / noise_var + num_params * log_N;

        if (have_best == 0)
        {
            best_bic  = bic;
            best_lam  = lam;
            have_best = 1;
        }
        else
        {
            if (bic < best_bic)
            {
                best_bic = bic;
                best_lam = lam;
            }
        }

        li++;
    }

    fit_one(best_lam);
    selected_lambda = best_lam;

    // Dump results to output ports.
    fout(0, selected_lambda);
    int j = 0;
    while (j < 7) { fout(1, h_hat[j]); j++; }
    j = 0;
    while (j < 1000) { fout(2, x_hat[j]); j++; }
}
